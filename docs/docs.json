{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Maia",
  "description": "Maia is a local agent. Model calls go through one LiteLLM endpoint. Chat runs in the web console.",
  "theme": "maple",
  "appearance": {
    "default": "light"
  },
  "colors": {
    "primary": "#4169E1",
    "light": "#6B8EF0",
    "dark": "#2F52C4"
  },
  "logo": {
    "light": "/images/logo.jpg",
    "dark": "/images/logo.jpg"
  },
  "favicon": "/images/favicon.ico",
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/dubhagen/Maia"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/dubhagen/Maia"
    }
  },
  "redirects": [
    {
      "source": "/en/:slug*",
      "destination": "/:slug*",
      "permanent": true
    }
  ],
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "navbar": {
          "links": [
            {
              "label": "GitHub",
              "href": "https://github.com/dubhagen/Maia"
            }
          ]
        },
        "tabs": [
          {
            "tab": "Introduction",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "intro/index",
                  "intro/architecture",
                  "intro/features"
                ]
              }
            ]
          },
          {
            "tab": "Get Started",
            "groups": [
              {
                "group": "Installation",
                "pages": [
                  "guide/quick-start",
                  "guide/desktop",
                  "guide/manual-install",
                  "guide/upgrade"
                ]
              }
            ]
          },
          {
            "tab": "Models",
            "groups": [
              {
                "group": "Model Configuration",
                "pages": [
                  "models/index"
                ]
              }
            ]
          },
          {
            "tab": "Tools",
            "groups": [
              {
                "group": "Tools System",
                "pages": [
                  "tools/index"
                ]
              },
              {
                "group": "Built-in Tools",
                "pages": [
                  "tools/read",
                  "tools/write",
                  "tools/edit",
                  "tools/ls",
                  "tools/search-files",
                  "tools/bash",
                  "tools/send",
                  "tools/memory",
                  "tools/env-config",
                  "tools/web-fetch",
                  "tools/scheduler",
                  "tools/delegate",
                  "tools/subagent"
                ]
              },
              {
                "group": "Optional Tools",
                "pages": [
                  "tools/web-search",
                  "tools/vision",
                  "tools/browser"
                ]
              },
              {
                "group": "MCP Tools",
                "pages": [
                  "tools/mcp"
                ]
              }
            ]
          },
          {
            "tab": "Skills",
            "groups": [
              {
                "group": "Skills System",
                "pages": [
                  "skills/index",
                  "skills/install",
                  "skills/create",
                  "skills/hub"
                ]
              },
              {
                "group": "Built-in Skills",
                "pages": [
                  "skills/skill-creator",
                  "skills/knowledge-wiki",
                  "skills/image-generation"
                ]
              }
            ]
          },
          {
            "tab": "Memory",
            "groups": [
              {
                "group": "Memory System",
                "pages": [
                  "memory/index",
                  "memory/context",
                  "memory/deep-dream",
                  "memory/self-evolution"
                ]
              }
            ]
          },
          {
            "tab": "Knowledge",
            "groups": [
              {
                "group": "Knowledge Base",
                "pages": [
                  "knowledge/index"
                ]
              }
            ]
          },
          {
            "tab": "Channels",
            "groups": [
              {
                "group": "Platforms",
                "pages": [
                  "channels/index",
                  "channels/web"
                ]
              }
            ]
          },
          {
            "tab": "CLI",
            "groups": [
              {
                "group": "Command System",
                "pages": [
                  "cli/index",
                  "cli/process",
                  "cli/skill",
                  "cli/memory-knowledge",
                  "cli/backup",
                  "cli/general"
                ]
              }
            ]
          },
          {
            "tab": "Multi-Agent",
            "groups": [
              {
                "group": "Multi-Agent System",
                "pages": [
                  "multi-agent/team",
                  "multi-agent/subagent"
                ]
              }
            ]
          },
          {
            "tab": "Extensions",
            "groups": [
              {
                "group": "API",
                "pages": [
                  "extensions/chat-api"
                ]
              },
              {
                "group": "Customization",
                "pages": [
                  "extensions/custom-menu"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
